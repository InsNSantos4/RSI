next_id() {
  date +%s                  #  ID a usar Timestamp
}

now_iso() {
  date -Iseconds            # Data Actual em ISO
}



is_iso_date() {
    case $1 in
        ????-??-??) return 0 ;;
        *) return 1 ;;
    esac
}

is_prio() {
    case $1 in
        1|2|3|4|5) return 0 ;;
        *) return 1 ;;
    esac
}

acquire_lock() {
    # TODO: implementar lock com mkdir atomico
    :
     lockdir="$LOCKS/todos.lock"
    while ! mkdir "$lockdir" 2>/dev/null; do
        sleep 0.1
    done
}

release_lock() {
    # TODO: libertar lock
    :
    lockdir="$LOCKS/todos.lock"
    rmdir "$lockdir" 2>/dev/null || true
}

cmd_todo_add() {
    [ "${1-}" = "-h" ] && {
        print_todo_add_help
        return 0
    }

    ensure_state -f

    title=
    prio=3
    due=
    tags=

    # Primeiro argumento é o título, 2 primeiros argumentos ja foram removidos
    [ $# -gt 0 ] || print "Falta titulo"
    title=$1
    shift


    while [ $# -gt 0 ]; do
        case $1 in
            -p)
                shift
                [ $# -gt 0 ] || print "Falta valor para -p"
                is_prio "$1"   "Prioridade invalida: $1"
                prio=$1
                ;;
            -d)
                shift
                [ $# -gt 0 ] || print "Falta valor para -d"
                is_iso_date "$1"   "Data invalida (esperado AAAA-MM-DD): $1"
                due=$1
                ;;
            -t)
                shift
                [ $# -gt 0 ] || print "Falta valor para -t"
                tags=$1
                ;;
            *)
                print "Opcao desconhecida em todo-add: $1"
                ;;
        esac
        shift
    done

    ensure_state
    acquire_lock

    id=$(next_id)
    created_at=$(now_iso)
    status=TODO
    done_at=



    printf '%s;%s;%s;%s;%s;%s;%s;%s\n' \
        "$id" "$status" "$prio" "$due" "$tags" "$created_at" "$done_at" "$title" >>"$TODOS"

    release_lock

    printf 'Criada tarefa %s\n' "$id"

}

cmd_todo_list() {
    [ "${1-}" = "-h" ] && {
        print_todo_list_help
        return 0
    }

    # TODO:
    # - suportar -a, -s, -t, -p
    # - filtrar e ordenar
    # - imprimir formatado
    # echo "TODO: implementar todo-list"

    show_all=0
    sort_key=created
    filter_tag=
    min_prio=1
    
    while [ $# -gt 0 ]; do
        case $1 in
            -a) show_all=1 ;;
            -s)
                shift
                case ${1-} in
                    due|prio|created)
                        sort_key=$1
                        ;;
                    *)
                        printf "Chave de ordenacao invalida: %s\n" "$1"
                        return 1
                        ;;
                esac
                ;;    
            -t)
                shift
                filter_tag=${1-}
                ;;
            -p)
                shift
                is_prio "${1-}"  printf "Prioridade invalida: $1"
                min_prio=$1
                ;;
            *)
                print "Opcao desconhecida em todo-list: $1"
                ;;
        esac
        shift
    done

    ensure_state
    [ -s "$TODOS" ] || { echo "Sem tarefas."; return 0; }

            #Sorting Case    
    case $sort_key in
        prio) sort_cmd="-t; -k3,3n" ;;
        due)  sort_cmd="-t; -k4,4" ;;
        created) sort_cmd="-t; -k6,6" ;;
    esac
    

            #Filtra e Imprime baseado em awk
    awk -F ';' -v show_all="$show_all" -v tag="$filter_tag" -v min_prio="$min_prio" '
        BEGIN { OFS=";" }
        {
            id=$1; status=$2; prio=$3; due=$4; tags=$5; created=$6; done_at=$7; title=$8
            if (!show_all && status != "TODO") next
            if (prio+0 < min_prio) next
            if (tag != "" && index(tags, tag) == 0) next
            print $0
        }
    ' "$TODOS" | sort $sort_cmd | awk -F';' '
        BEGIN { printf "%-4s %-6s %-5s %-12s %-20s %s\n", "ID","STAT","PRIO","DUE","TAGS","TITLE" }
        {
            printf "%-4s %-6s %-5s %-12s %-20s %s\n", $1,$2,$3,$4,$5,$8
        }
    '

}


cmd_todo_done() {
    [ "${1-}" = "-h" ] && {
        print_todo_done_help
        return 0
    }


    [ $# -eq 1 ] || print "Uso: todo-done <id>"
    id_target=$1

    ensure_state
    [ -s "$TODOS" ] || print "Sem tarefas."

    acquire_lock

    tmp=$(mktemp)
    found=0
    now=$(now_iso)

    awk -F';' -v idt="$id_target" -v now="$now" '
        BEGIN { OFS=";" }
        {
            if ($1 == idt) {
                found=1
                $2="DONE"
                $7=now
            }
            print $0
        }
        END {
            if (!found) {   
                exit 2
            }
        }
    ' "$TODOS" >"$tmp"
    rc=$?               #Guardar o que sai do awk

    if [ $rc -eq 2 ]; then
        rm -f "$tmp"
        release_lock
        err "ID nao encontrado: $id_target"
    fi

    mv "$tmp" "$TODOS"
    release_lock

    echo "Tarefa $id_target marcada como DONE"


}

cmd_todo_search() {
    [ "${1-}" = "-h" ] && {
        print_todo_search_help
        return 0
    }


    [ $# -ge 1 ] || err "Uso: todo-search <texto>"
    text=$*
    ensure_state
    [ -s "$TODOS" ] ||  { echo "Sem tarefas."; return 0; }

    awk -F';' -v q="$text" '
        BEGIN {
            IGNORECASE=1
            printf "%-4s %-6s %-5s %-12s %-20s %s\n", "ID","STAT","PRIO","DUE","TAGS","TITLE"
        }
        {
            if (index($8, q) > 0) {
                printf "%-4s %-6s %-5s %-12s %-20s %s\n", $1,$2,$3,$4,$5,$8
            }
        }
    ' "$TODOS"


}

