#!/bin/sh

PROG=$(basename "$0")

STATE=${HOME:-.}/.handin_mgr
TODOS=$STATE/todos.csv
RUNS=$STATE/runs
LOCKS=$STATE/locks

err() {
    printf '%s\n' "$*" >&2
}

die() {
    err "$*"
    exit 1
}

ensure_state() {
   

    [ -d "$STATE" ] || mkdir -p "$STATE" || { echo "Erro ao criar $STATE"; exit 1; }
    [ -d "$RUNS" ] || mkdir -p "$RUNS" || { echo "Erro ao criar $RUNS"; exit 1; }
    [ -d "$LOCKS" ] || mkdir -p "$LOCKS" || { echo "Erro ao criar $LOCKS"; exit 1; }
    [ -f "$TODOS" ] || : > "$TODOS" || { echo "Erro ao criar $TODOS"; exit 1; }

}


